# WhatsApp Appointment Scheduler Configuration

# Server Settings
APP_NAME="WhatsApp Appointment Scheduler"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Database Settings
DATABASE_URL=sqlite:///./appointments.db

# Clinic Business Rules
APP_TIMEZONE=UTC
SLOT_DURATION_MINUTES=30
WORK_START_HOUR=9
WORK_END_HOUR=17

# WhatsApp Integration Mode: "mock" (default) or "meta"
WHATSAPP_PROVIDER=mock

# Live Meta WhatsApp Cloud API (Required only if WHATSAPP_PROVIDER=meta)
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=appointment_scheduler_verify_token
META_APP_SECRET=

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "http://localhost:5175", "http://127.0.0.1:5175", "http://localhost:3000", "http://127.0.0.1:3000"]
