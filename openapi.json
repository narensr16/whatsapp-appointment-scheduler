{
  "openapi": "3.1.0",
  "info": {
    "title": "WhatsApp Appointment Scheduler",
    "description": "Production-quality backend for WhatsApp-Based Appointment Scheduling System. Supports REST appointment bookings, natural-language WhatsApp webhook interactions, conflict resolution, and doctor availability management.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health check endpoint",
        "description": "Returns application health status, version, and verifies database connectivity.",
        "operationId": "check_health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/appointments/": {
      "post": {
        "tags": [
          "Appointments"
        ],
        "summary": "Create a new doctor appointment",
        "description": "Validates doctor availability, working hours, and bookable slot, then creates a confirmed appointment.",
        "operationId": "create_appointment_appointments__post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Appointment successfully booked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input, past slot, or invalid slot timing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Doctor not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Slot conflict - appointment slot already booked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "List appointments",
        "description": "Retrieve appointments filtered by doctor, patient phone number, or date.",
        "operationId": "list_appointments_appointments__get",
        "parameters": [
          {
            "name": "doctor_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by doctor ID",
              "title": "Doctor Id"
            },
            "description": "Filter by doctor ID"
          },
          {
            "name": "user_phone",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by patient phone number",
              "title": "User Phone"
            },
            "description": "Filter by patient phone number"
          },
          {
            "name": "appointment_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by appointment date (YYYY-MM-DD)",
              "title": "Appointment Date"
            },
            "description": "Filter by appointment date (YYYY-MM-DD)"
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Skip"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AppointmentResponse"
                  },
                  "title": "Response List Appointments Appointments  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/appointments/{appointment_id}": {
      "get": {
        "tags": [
          "Appointments"
        ],
        "summary": "Get appointment by ID",
        "description": "Retrieve details of a single appointment by its ID.",
        "operationId": "get_appointment_appointments__appointment_id__get",
        "parameters": [
          {
            "name": "appointment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Appointment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Appointments"
        ],
        "summary": "Cancel an appointment",
        "description": "Mark an appointment as cancelled.",
        "operationId": "cancel_appointment_appointments__appointment_id__delete",
        "parameters": [
          {
            "name": "appointment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Appointment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/whatsapp/": {
      "get": {
        "tags": [
          "WhatsApp Webhook"
        ],
        "summary": "Meta WhatsApp Webhook Verification Handshake",
        "description": "Endpoint for Meta Cloud API webhook subscription challenge.",
        "operationId": "verify_meta_webhook_whatsapp__get",
        "parameters": [
          {
            "name": "hub.mode",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hub.Mode"
            }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hub.Verify Token"
            }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hub.Challenge"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "WhatsApp Webhook"
        ],
        "summary": "Handle incoming WhatsApp message webhook",
        "description": "Accepts WhatsApp message (either mock or Meta format), parses intent, executes booking, and responds.",
        "operationId": "handle_whatsapp_webhook_whatsapp__post",
        "parameters": [
          {
            "name": "x-hub-signature-256",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Hub-Signature-256"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatsAppResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/doctors/": {
      "get": {
        "tags": [
          "Doctors"
        ],
        "summary": "List all active doctors",
        "description": "Fetch all doctors available for appointments.",
        "operationId": "list_doctors_doctors__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DoctorResponse"
                  },
                  "type": "array",
                  "title": "Response List Doctors Doctors  Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Doctors"
        ],
        "summary": "Register a new doctor",
        "description": "Add a new doctor to the clinic roster.",
        "operationId": "create_doctor_doctors__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DoctorCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/doctors/{doctor_id}/slots": {
      "get": {
        "tags": [
          "Doctors"
        ],
        "summary": "Get available slots for a doctor on a specific date",
        "description": "Returns available 30-minute booking slots for a doctor on the requested date.",
        "operationId": "get_doctor_available_slots_doctors__doctor_id__slots_get",
        "parameters": [
          {
            "name": "doctor_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Doctor Id"
            }
          },
          {
            "name": "target_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Date to check (defaults to today)",
              "title": "Target Date"
            },
            "description": "Date to check (defaults to today)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DoctorSlotsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Root"
        ],
        "summary": "Root Redirect",
        "description": "Root endpoint welcoming developers and pointing to Swagger documentation.",
        "operationId": "root_redirect__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppointmentCreate": {
        "properties": {
          "user_phone": {
            "type": "string",
            "maxLength": 32,
            "title": "User Phone",
            "examples": [
              "+14155552671"
            ]
          },
          "doctor_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Doctor Id",
            "examples": [
              1
            ]
          },
          "slot": {
            "type": "string",
            "format": "date-time",
            "title": "Slot",
            "examples": [
              "2026-10-15T10:00:00"
            ]
          }
        },
        "type": "object",
        "required": [
          "user_phone",
          "doctor_id",
          "slot"
        ],
        "title": "AppointmentCreate",
        "description": "Validated request schema for creating an appointment:\n- user_phone: international or local phone number (normalized to digits with optional leading '+')\n- doctor_id: positive integer ID of active doctor\n- slot: datetime representing booking slot"
      },
      "AppointmentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "examples": [
              1
            ]
          },
          "user_phone": {
            "type": "string",
            "title": "User Phone",
            "examples": [
              "+14155552671"
            ]
          },
          "doctor_id": {
            "type": "integer",
            "title": "Doctor Id",
            "examples": [
              1
            ]
          },
          "slot": {
            "type": "string",
            "format": "date-time",
            "title": "Slot",
            "examples": [
              "2026-10-15T10:00:00"
            ]
          },
          "status": {
            "type": "string",
            "title": "Status",
            "default": "CONFIRMED",
            "examples": [
              "CONFIRMED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "doctor_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doctor Name",
            "examples": [
              "Dr. Alice Smith"
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "user_phone",
          "doctor_id",
          "slot",
          "created_at"
        ],
        "title": "AppointmentResponse",
        "description": "Success response returned upon booking creation."
      },
      "DoctorCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Name",
            "examples": [
              "Dr. Alice Smith"
            ]
          },
          "specialty": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialty",
            "default": "General Physician",
            "examples": [
              "Cardiologist"
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "examples": [
              "+1234567890"
            ]
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true,
            "examples": [
              true
            ]
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DoctorCreate"
      },
      "DoctorResponse": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Name",
            "examples": [
              "Dr. Alice Smith"
            ]
          },
          "specialty": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialty",
            "default": "General Physician",
            "examples": [
              "Cardiologist"
            ]
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 32
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "examples": [
              "+1234567890"
            ]
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active",
            "default": true,
            "examples": [
              true
            ]
          },
          "id": {
            "type": "integer",
            "title": "Id",
            "examples": [
              1
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "name",
          "id",
          "created_at"
        ],
        "title": "DoctorResponse"
      },
      "DoctorSlotsResponse": {
        "properties": {
          "doctor_id": {
            "type": "integer",
            "title": "Doctor Id"
          },
          "doctor_name": {
            "type": "string",
            "title": "Doctor Name"
          },
          "date": {
            "type": "string",
            "title": "Date"
          },
          "available_slots": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available Slots"
          }
        },
        "type": "object",
        "required": [
          "doctor_id",
          "doctor_name",
          "date",
          "available_slots"
        ],
        "title": "DoctorSlotsResponse"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail",
            "examples": [
              "The requested slot is already booked."
            ]
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok",
            "examples": [
              "ok"
            ]
          },
          "app_name": {
            "type": "string",
            "title": "App Name",
            "examples": [
              "WhatsApp Appointment Scheduler"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "1.0.0"
            ]
          },
          "database": {
            "type": "string",
            "title": "Database",
            "default": "connected",
            "examples": [
              "connected"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          }
        },
        "type": "object",
        "required": [
          "app_name",
          "version",
          "timestamp"
        ],
        "title": "HealthResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WhatsAppResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "success"
            ]
          },
          "reply": {
            "type": "string",
            "title": "Reply",
            "examples": [
              "Your appointment with Dr. Alice Smith is confirmed for tomorrow at 10:00 AM."
            ]
          },
          "appointment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AppointmentResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "suggested_slots": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Suggested Slots"
          },
          "message_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message Id"
          }
        },
        "type": "object",
        "required": [
          "status",
          "reply"
        ],
        "title": "WhatsAppResponse",
        "description": "Standardized response from the WhatsApp webhook endpoint."
      }
    }
  }
}